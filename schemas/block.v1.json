{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caprivm/flowaction-catalog/blob/main/schemas/block.v1.json",
  "title": "FlowAction block manifest",
  "description": "flowaction.block/v1: describes a block whose work runs in a workflow_call reusable workflow, or a catalog block FlowAction holds itself (bpmn:UserTask, no workflow). Lives at .flowaction/blocks/<id>/block.json in the catalog or in an execution repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "version", "label", "description", "bpmnType"],
  "if": {
    "properties": { "bpmnType": { "const": "bpmn:UserTask" } }
  },
  "then": {
    "not": { "required": ["workflow"] }
  },
  "else": {
    "required": ["workflow"]
  },
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "flowaction.block/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "bpmnType": {
      "enum": [
        "bpmn:ServiceTask",
        "bpmn:ScriptTask",
        "bpmn:SendTask",
        "bpmn:UserTask"
      ],
      "description": "bpmn:UserTask blocks wait in FlowAction for a person and have no workflow; only the catalog defines them."
    },
    "workflow": {
      "type": "string",
      "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
    },
    "inputs": {
      "type": "array",
      "maxItems": 50,
      "description": "Inputs shown in the modeler. task_id and runs_on are filled by FlowAction and must not be listed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "not": { "enum": ["task_id", "runs_on"] }
          },
          "type": { "enum": ["string", "number", "boolean"] },
          "required": { "type": "boolean", "default": false },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "maxLength": 500 },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Allowed values; string inputs only."
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "required": { "type": "boolean", "default": false },
          "description": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "description": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
